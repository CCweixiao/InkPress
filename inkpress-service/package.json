{
  "name": "inkpress-service",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "InkPress 用户服务、认证、License 与管理后台服务（独立部署）",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:backup": "tsx scripts/backup-db.ts",
    "init-admin": "tsx scripts/init-admin.ts",
    "gen-token-key": "tsx scripts/gen-token-key.ts",
    "test:email": "tsx scripts/test-email.ts",
    "publish:oss": "tsx scripts/publish-oss.ts",
    "release:register": "tsx scripts/register-release.ts",
    "release:full": "cd .. && pnpm electron:build:arm64 && cd inkpress-service && pnpm publish:oss && pnpm release:register",
    "admin:sync": "tsx scripts/init-production.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "ali-oss": "^6.23.0",
    "alipay-sdk": "^4.14.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.31",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.16.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/ali-oss": "^6.23.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0"
  }
}
