# ── InkPress Service 基础镜像 ──
#
# 包含: Node.js 22 + openssl + 构建工具 + pnpm + 用户/目录
# 长期稳定，仅在系统依赖变化时重建（一般半年一次）。
#
# 构建命令（在服务器或本地执行）:
#   docker build -f Dockerfile.base -t inkpress-service-base:latest .
#
# 镜像层不会随应用代码变化，所以 docker build app 时这一层 100% 命中缓存。

FROM node:22-bookworm-slim

# 国内镜像加速（apt + npm）。海外构建可注释掉 sed 行 + 用 NPM_REGISTRY 覆盖。
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
       openssl ca-certificates python3 make g++ curl \
  && rm -rf /var/lib/apt/lists/*

# pnpm（通过 corepack）
RUN corepack enable

# npm 镜像加速
ENV npm_config_registry=${NPM_REGISTRY} \
  NEXT_TELEMETRY_DISABLED=1

# 非 root 用户 + 数据目录
RUN groupadd -r nodejs && useradd -r -g nodejs nextjs \
  && mkdir -p /data && chown -R nextjs:nodejs /data

WORKDIR /app
