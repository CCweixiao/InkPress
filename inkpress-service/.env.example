# ===== 数据库 =====
# 开发：本地文件；生产（Docker）：固定 /data/inkpress-service.db
DATABASE_URL="file:./dev.db"
# DATABASE_URL="file:/data/inkpress-service.db"

# ===== NextAuth / Auth.js =====
# 生成：openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# 服务公网地址
NEXTAUTH_URL="http://localhost:3001"
# 生产 HTTPS 下设 true，cookie 加 Secure
SECURE_COOKIES=false

# ===== GitHub OAuth =====
# 留空则不启用 GitHub 登录
GITHUB_ID=""
GITHUB_SECRET=""
# 与 GITHUB_ID/SECRET 配套：设为 1 时前端登录页显示 GitHub 按钮
NEXT_PUBLIC_GITHUB_ENABLED=""

# ===== License =====
# License Key 哈希 pepper（生成：openssl rand -base64 32）。一旦轮换需重发所有 key。
LICENSE_KEY_PEPPER=""
# 查看完整 License Key 的二次密码；开发环境未配置时默认 123456，生产建议显式配置强密码。
LICENSE_KEY_VIEW_PASSWORD="123456"
# 保存完整 License Key 的 AES-256-GCM 加密密钥（32 字节 base64）。生成：openssl rand -base64 32
LICENSE_KEY_ENCRYPTION_SECRET=""
# activationSecret 加密密钥（AES-256 KEK，32 字节 base64）。生成：openssl rand -base64 32
ACTIVATION_SECRET_KEK=""
# licenseToken Ed25519 签名密钥（生成：pnpm gen-token-key）。私钥保密不入库/镜像。
LICENSE_TOKEN_PRIVATE_KEY=""
LICENSE_TOKEN_PUBLIC_KEY=""

# ===== 邮件 =====
# 开发用 console（验证码写 stdout + data/dev-mail.log）；生产用 smtp 或 resend
MAIL_PROVIDER="console"
MAIL_FROM="InkPress <noreply@example.com>"

# SMTP（MAIL_PROVIDER=smtp 时启用）
# QQ 邮箱示例：host=smtp.qq.com / port=465 / secure=true / user=完整邮箱 / pass=授权码
# 开启步骤：mail.qq.com → 设置 → 账户 → POP3/IMAP/SMTP → 开启 SMTP 服务 → 获取授权码
# 注意：SMTP_PASS 是 16 位授权码（非 QQ 登录密码）
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="true"

# Resend（MAIL_PROVIDER=resend，海外推荐，需域名验证）
RESEND_API_KEY=""

# 发件超时秒数（SMTP/Resend，默认 10）
MAIL_TIMEOUT_SEC="10"

# ===== 管理员初始化 =====
# 仅在数据库无任何 ADMIN 时生效，幂等
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# ===== 日志 =====
LOG_LEVEL="info"

# ===== 安全加固与运维（Phase 4） =====
# 安全响应头开关（CSP/HSTS/X-Frame 等），默认开启；排障时可设 false
SECURITY_HEADERS_ENABLE="true"
# 备份留存份数（pnpm db:backup 保留最近 N 份，默认 14）
BACKUP_RETENTION="14"
# 异常风控：按失败信号模式临时封禁 IP。RISK_DISABLE=true 整体关闭。
RISK_DISABLE="false"
# 激活失败（key 枚举/失效）：N 次 / 窗口秒 触发封禁
RISK_ACTIVATION_FAIL_THRESHOLD="20"
RISK_ACTIVATION_FAIL_WINDOW="600"
# 签名/重放失败：N 次 / 窗口秒 触发封禁
RISK_SIGNATURE_FAIL_THRESHOLD="30"
RISK_SIGNATURE_FAIL_WINDOW="600"
# 命中阈值后封禁分钟数
RISK_BLOCK_MINUTES="30"
