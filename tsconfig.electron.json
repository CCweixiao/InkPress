{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false,
    "resolveJsonModule": true,
    "lib": ["ES2022"]
  },
  "include": ["electron/**/*.ts"]
}
