# 发布产物上传 OSS 凭据模板
#
# 复制本文件为 .env.publish 并填入真实值：
#   cp .env.publish.example .env.publish
#
# .env.publish 已被 .gitignore 的 .env* 规则忽略，不会提交。
#
# 用法：scripts/publish-oss.ts 会自动加载 .env.publish。
#      执行 pnpm publish:oss 上传 DMG 等产物到阿里云 OSS。

# OSS Region（去掉 oss- 前缀，如 shanghai / hangzhou / beijing）
OSS_PUBLISH_REGION=shanghai

# OSS Bucket 名称
OSS_PUBLISH_BUCKET=your-bucket-name

# OSS AccessKey（建议使用仅具备该 Bucket 写权限的 RAM 子账号）
OSS_PUBLISH_ACCESS_KEY_ID=your-access-key-id
OSS_PUBLISH_ACCESS_KEY_SECRET=your-access-key-secret

# OSS 路径前缀（产物上传到 {bucket}/{prefix}/releases/{version}/ 下）
# 留空则上传到 bucket 根目录的 releases/ 下
OSS_PUBLISH_PATH_PREFIX=inkpress
