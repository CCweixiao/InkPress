// AI 驱动的公众号文章编写与发布系统 — 数据模型
// SQLite 零运维，未来可平滑迁移至 Postgres

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Article {
  id           String    @id @default(cuid())
  title        String    @default("") // 标题
  contentMd    String    @default("") // 已迁移到文件存储，此列保留作兼容（实际正文读 contentPath）
  contentPath  String? // 正文文件相对路径（相对 storage 根，如 articles/<id>.md）
  digest       String? // 摘要（≤120 字）
  coverMediaId String? // 微信封面 media_id（add_material 返回）
  coverAssetId String? // OSS 封面 Asset id（素材库封面，区别于微信）
  coverUrl     String? // 封面可访问 URL（直接读，列表展示用，与 coverAssetId 并存冗余）
  themeId      String? // 关联 Theme
  spaceId      String? // 关联 Space（可为空=未分类）
  status       String    @default("draft") // draft | ready | pushed
  wxMediaId    String? // draft/add 返回的 media_id（= 草稿箱 id）
  // 软删除 / 回收站
  trashed      Boolean   @default(false)
  trashedAt    DateTime?
  expiresAt    DateTime? // 回收站过期时间（trashedAt + 30d）
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  theme Theme? @relation(fields: [themeId], references: [id])
  space Space? @relation(fields: [spaceId], references: [id])

  assets           Asset[]
  agentChatSession AgentChatSession?
  agentProposals   AgentArticleProposal[]

  @@index([themeId])
  @@index([spaceId])
  @@index([trashed])
}

model AgentChatSession {
  id                  String   @id @default(cuid())
  articleId           String?  @unique
  technicalDocumentId String?  @unique
  targetKind          String   @default("article") // article | technical-document
  summary             String   @default("")
  summaryUpToPosition Int      @default(-1)
  selectedProjectId   String?
  providerId          String?
  modelId             String?
  lastInputTokens     Int      @default(0)
  lastOutputTokens    Int      @default(0)
  lastReasoningTokens Int      @default(0)
  lastTotalTokens     Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  article           Article?           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  technicalDocument TechnicalDocument? @relation(fields: [technicalDocumentId], references: [id], onDelete: Cascade)
  messages          AgentChatMessage[]
  codeSourceGrants  CodeSourceGrant[]

  @@index([articleId])
  @@index([technicalDocumentId])
}

model CodeSourceGrant {
  id                String    @id @default(cuid())
  sessionId         String
  kind              String // local | github | configured
  sourceKey         String
  displayName       String
  locator           String
  root              String?
  owner             String?
  repo              String?
  ref               String?
  cacheRoot         String?
  scope             String    @default("session") // session | trusted
  status            String    @default("pending") // pending | approved | rejected | revoked
  approvalTokenHash String?
  approvedAt        DateTime?
  lastAccessedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  session AgentChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sourceKey])
  @@index([sessionId, status])
  @@index([sourceKey])
}

model AgentChatMessage {
  id           String   @id
  sessionId    String
  role         String
  partsJson    String
  metadataJson String?
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session AgentChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, position])
  @@index([sessionId])
}

model AgentArticleProposal {
  id              String    @id @default(cuid())
  articleId       String
  sessionId       String?
  baseVersionHash String
  baseTitle       String    @default("")
  baseMarkdown    String    @default("")
  baseDigest      String    @default("")
  title           String?
  markdown        String
  digest          String?
  summary         String    @default("")
  status          String    @default("pending") // pending | applying | applied | rejected | superseded
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  appliedAt       DateTime?
  decidedAt       DateTime?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([sessionId])
  @@index([status])
}

model TechnicalDocument {
  id           String   @id @default(cuid())
  title        String   @default("")
  documentType String   @default("architecture") // architecture | implementation | call-chain | module-reference | dependency
  projectId    String
  contentPath  String?
  snapshotHash String   @default("")
  codeSourceJson String @default("{}")
  status       String   @default("draft")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chatSession AgentChatSession?
  versions    TechnicalDocumentVersion[]
  proposals   AgentTechnicalDocumentProposal[]

  @@index([projectId])
  @@index([updatedAt])
}

/// 统一存储对象：只描述文件实际存放位置和完整性。
/// SQLite 保留元数据；文件可位于本地 storage、阿里云 OSS 或未来的 S3/R2/COS/MinIO。
model StorageObject {
  id           String   @id @default(cuid())
  provider     String // local | aliyun-oss | s3 | r2 | cos | qiniu | minio
  bucket       String?
  key          String // provider 内部对象 key；local 时为 storage 根下相对路径
  localPath    String? // local provider 的相对路径，等同 key；保留字段便于迁移/审计
  url          String? // 可访问 URL；local provider 通常为 /api/storage/<id>
  contentType  String   @default("")
  size         Int      @default(0)
  sha256       String
  etag         String?
  visibility   String   @default("private") // private | public
  status       String   @default("synced") // local-only | remote-only | synced | failed
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assets Asset[]

  @@unique([provider, key])
  @@index([sha256])
  @@index([provider])
  @@index([createdAt])
}

/// 代码知识图谱缓存元数据。
/// 图谱文件本身落在 InkPress 本地数据目录，不进入文章素材统一存储层。
model CodeGraphCache {
  id           String   @id @default(cuid())
  provider     String   @default("graphify")
  status       String   @default("pending") // pending | building | ready | failed | stale
  spaceId      String?
  articleId    String?
  sourceKey    String
  projectName  String   @default("")
  root         String   @default("")
  snapshotHash String   @default("")
  gitHead      String?
  graphAssetId String?
  reportAssetId String?
  htmlAssetId  String?
  graphPath    String?
  reportPath   String?
  htmlPath     String?
  nodeCount    Int      @default(0)
  edgeCount    Int      @default(0)
  lastError    String?
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sourceKey])
  @@index([spaceId])
  @@index([articleId])
  @@index([snapshotHash])
  @@index([status])
}

model TechnicalDocumentVersion {
  id                  String   @id @default(cuid())
  technicalDocumentId String
  version             Int
  title               String
  markdown            String
  snapshotHash        String   @default("")
  sourceSnapshotJson  String   @default("{}")
  createdAt           DateTime @default(now())

  technicalDocument TechnicalDocument @relation(fields: [technicalDocumentId], references: [id], onDelete: Cascade)

  @@unique([technicalDocumentId, version])
  @@index([technicalDocumentId])
}

model AgentTechnicalDocumentProposal {
  id                  String    @id @default(cuid())
  technicalDocumentId String
  sessionId           String?
  baseVersionHash     String
  baseTitle           String    @default("")
  baseMarkdown        String    @default("")
  baseSnapshotHash    String    @default("")
  title               String?
  markdown            String
  snapshotHash        String?
  sourceSnapshotJson  String    @default("{}")
  summary             String    @default("")
  status              String    @default("pending")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  appliedAt           DateTime?
  decidedAt           DateTime?

  technicalDocument TechnicalDocument @relation(fields: [technicalDocumentId], references: [id], onDelete: Cascade)

  @@index([technicalDocumentId])
  @@index([sessionId])
  @@index([status])
}

model Space {
  id          String    @id @default(cuid())
  name        String // 空间名称
  description String    @default("") // 空间描述
  tagsJson    String    @default("[]") // 标签 JSON 数组
  sortOrder   Int       @default(0)
  isDefault   Boolean   @default(false) // 是否为默认空间（不可编辑/删除，至多一个）
  pinned      Boolean   @default(false) // 是否置顶（排序优先级：默认 > 置顶 > createdAt 倒序）
  // 软删除 / 回收站
  trashed     Boolean   @default(false)
  trashedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles Article[]
  assets   Asset[]

  @@index([trashed])
}

model Theme {
  id           String   @id @default(cuid())
  name         String // 显示名，如「优雅蓝」
  cssContent   String // markdown 主题 CSS（裸选择器）
  codeTheme    String   @default("atom-one-dark") // 代码高亮主题名
  primaryColor String?  @default("#3f51b5") // 用于解析 var()
  isBuiltIn    Boolean  @default(false)
  isDefault    Boolean  @default(false) // 是否为默认主题（DB 层至多一个为 true，由应用保证）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articles Article[]
}

model Material {
  // 图片缓存：外链 URL → wx_src 映射，避免重复上传
  id         String   @id @default(cuid())
  sourceUrl  String // 原始外链
  sourceHash String   @unique // sha1(sourceUrl)
  wxUrl      String? // uploadimg 返回的正文图 URL
  wxMediaId  String? // add_material 返回（封面用）
  kind       String // "body" | "cover"
  createdAt  DateTime @default(now())
}

/// 技能仓库（用户级 skill）
/// 通过界面新增/AI 生成的 skill 均落此表，同时镜像写入 resources/skills/<key>/SKILL.md
/// 使写作 agent 的 listSkills() 自动识别。resources/skills 下无 DB 记录的目录视为系统 skill（只读）。
model Skill {
  id           String   @id @default(cuid())
  skillKey     String   @unique // resources/skills 下的目录名（slugged）
  name         String // 显示名（取自 frontmatter）
  description  String   @default("")
  manual       String   @default("") // SKILL.md 正文（frontmatter 之后）
  promptHint   String? // AI 生成时记录的用途描述；手动新建为 null
  manifest     String? // 资源清单 JSON（压缩包上传时扫描得到，如 {"scripts":[...],"references":[...]}）
  hasResources Boolean  @default(false) // 是否含非 SKILL.md 的额外资源（references/scripts/agents 等）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

/// 系统级配置（key/value，value 为 JSON 字符串）
/// inkpress.llm = AI 模型配置数组，inkpress.oss = OSS 配置对象
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // JSON 字符串
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 文章素材库（统一存储的图片 / 视频 / 音频 / 文件）
/// 双重归属：可绑定到 Space（spaceId）和/或 Article（articleId）
model Asset {
  id          String    @id @default(cuid())
  name        String // 展示名（自动生成的短 UUID，如 a1b2c3d4.png）
  ossKey      String // 兼容旧字段：对象 key（OSS 或统一存储 key）
  url         String // 兼容旧字段：可访问 URL（云 URL 或 /api/storage/<id>）
  kind        String // "image" | "video" | "audio" | "file" | ...
  size        Int       @default(0) // 字节
  contentType String    @default("") // mime
  storageObjectId String?
  metadataJson String    @default("{}")
  // 元数据（供 AI 自动插图判断相关性）
  description String    @default("") // 素材描述
  tagsJson    String    @default("[]") // 标签（JSON 字符串数组）
  // 归属
  spaceId     String? // 所属空间（可空）
  articleId   String? // 所属文章（可空，编辑器内上传的素材）
  // 软删除 / 回收站
  trashed     Boolean   @default(false)
  trashedAt   DateTime?
  expiresAt   DateTime?
  // 微信公众号素材库同步（仅当上传时勾选了同步才写入；null=未尝试过同步）
  wxMediaId    String?  // add_material 返回的 media_id（永久素材）
  wxUrl        String?  // uploadimg 返回的 URL（正文图）或 add_material 的 url
  wxSyncStatus String?  // "success" | "failed" | null（null=未勾选同步）
  wxSyncError  String?  // 失败原因（同步失败时填，成功时清空）
  wxSyncedAt   DateTime? // 最后一次同步时间（成功/失败均更新）
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  storageObject StorageObject? @relation(fields: [storageObjectId], references: [id], onDelete: SetNull)
  space   Space?   @relation(fields: [spaceId], references: [id])
  article Article? @relation(fields: [articleId], references: [id])

  @@index([kind])
  @@index([createdAt])
  @@index([storageObjectId])
  @@index([spaceId])
  @@index([articleId])
  @@index([trashed])
  @@index([wxSyncStatus])
}
