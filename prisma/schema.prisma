// AI 驱动的公众号文章编写与发布系统 — 数据模型
// SQLite 零运维，未来可平滑迁移至 Postgres

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Article {
  id           String    @id @default(cuid())
  title        String    @default("") // 标题
  contentMd    String    @default("") // 已迁移到文件存储，此列保留作兼容（实际正文读 contentPath）
  contentPath  String? // 正文文件相对路径（相对 storage 根，如 articles/<id>.md）
  contentRevision Int @default(0) // 正文 CAS 版本，随每次正文写入递增
  digest       String? // 摘要（≤120 字）
  coverMediaId String? // 微信封面 media_id（add_material 返回）
  coverAssetId String? // OSS 封面 Asset id（素材库封面，区别于微信）
  coverUrl     String? // 封面可访问 URL（直接读，列表展示用，与 coverAssetId 并存冗余）
  themeId      String? // 关联 Theme
  spaceId      String? // 关联 Space（可为空=未分类）
  profileId    String? // P3 文章类型 profile（wechat_essay / technical_deep_dive / ...）
  status       String    @default("draft") // draft | ready | pushed
  wxMediaId    String? // draft/add 返回的 media_id（= 草稿箱 id）
  // 软删除 / 回收站
  trashed      Boolean   @default(false)
  trashedAt    DateTime?
  expiresAt    DateTime? // 回收站过期时间（trashedAt + 30d）
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  theme Theme? @relation(fields: [themeId], references: [id])
  space Space? @relation(fields: [spaceId], references: [id])

  assets           Asset[]
  snippets         Snippet[]
  snippetUsages    SnippetUsage[]
  agentChatSession AgentChatSession?
  agentProposals   AgentArticleProposal[]

  @@index([themeId])
  @@index([spaceId])
  @@index([trashed])
}

model AgentChatSession {
  id                  String   @id @default(cuid())
  articleId           String?  @unique
  technicalDocumentId String?  @unique
  targetKind          String   @default("article") // article | technical-document
  summary             String   @default("")
  summaryUpToPosition Int      @default(-1)
  selectedProjectId   String?
  providerId          String?
  modelId             String?
  // Agent Runtime 标记与 Claude Agent SDK 会话句柄。
  runtime             String   @default("claude-agent")
  claudeAgentSessionId String?
  claudeAgentStoreKey  String?
  // P2（session PDC §6.1）：Claude SDK 会话健康状态，供前端低存在感提示与中断后「继续」入口。
  // none|running|ready|interrupted|error|cleared。独立于 usage ledger，/clear 置 cleared（不删 AgentUsageTurn）。
  // NOT NULL + default 'none'：状态机列恒为合法枚举（PDC §6.1 原文即 @default("none")）。
  claudeAgentSessionStatus  String   @default("none") // none | running | ready | interrupted | error | cleared
  claudeAgentLastEventAt    DateTime?
  claudeAgentLastError      String?
  claudeAgentInterruptedAt  DateTime?
  claudeAgentResumeCount    Int       @default(0)
  lastInputTokens     Int      @default(0)
  lastOutputTokens    Int      @default(0)
  lastReasoningTokens Int      @default(0)
  lastTotalTokens     Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  article           Article?           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  technicalDocument TechnicalDocument? @relation(fields: [technicalDocumentId], references: [id], onDelete: Cascade)
  messages          AgentChatMessage[]
  codeSourceGrants  CodeSourceGrant[]
  toolActionGrants  ToolActionGrant[]
  snippetInjectionReviews SnippetInjectionReview[]

  @@index([articleId])
  @@index([technicalDocumentId])
}

model SnippetInjectionReview {
  id            String    @id @default(cuid())
  sessionId     String
  status        String    @default("pending") // pending | applied | rejected | error
  composerJson  String
  snippetsJson  String
  analysisJson  String    @default("{}")
  visibleText   String
  runtimeText   String
  providerId    String?
  modelId       String?
  error         String?
  appliedAt     DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  session AgentChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([sessionId, status])
}

model CodeSourceGrant {
  id                String    @id @default(cuid())
  sessionId         String
  kind              String // local | github | configured
  sourceKey         String
  displayName       String
  locator           String
  root              String?
  owner             String?
  repo              String?
  ref               String?
  cacheRoot         String?
  scope             String    @default("session") // session | trusted
  status            String    @default("pending") // pending | approved | rejected | revoked
  approvalTokenHash String?
  approvedAt        DateTime?
  lastAccessedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  session AgentChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sourceKey])
  @@index([sessionId, status])
  @@index([sourceKey])
}

// P3 权限闸门：canUseTool 命中 ASK 时落一行 pending grant，外部 /api/ai/agent-approvals 决议。
model ToolActionGrant {
  id                String   @id @default(cuid())
  sessionId         String
  runtime           String   @default("claude-agent")
  toolName          String // 裸名（如 set_article_digest）
  inputHash         String // sha256(JSON.stringify(input))，审计用
  status            String   @default("pending") // pending | approved | rejected | expired
  approvalTokenHash String?
  decisionJson      String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  session AgentChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([toolName])
}

/// P1.5 Token usage ledger：每个对话轮次的 token/cost 汇总，独立于 AgentChatMessage 生命周期。
/// 刻意不建到 AgentChatSession 的 Prisma 关系（无 FK）：删除消息/会话/文章不应影响历史消耗统计
/// （PDC §12.2/§12.6）。sessionId/targetKind/targetId 均为普通字符串，删除目标后仍可聚合，
/// 大盘可显示「已删除文章/文档」。
model AgentUsageTurn {
  id                       String   @id @default(cuid())
  sessionId                String
  turnId                   String
  targetKind               String // article | technical-document
  targetId                 String
  providerId               String?
  modelId                  String?
  sdkSessionId             String?
  inputTokens              Int      @default(0)
  outputTokens             Int      @default(0)
  cacheReadInputTokens     Int      @default(0)
  cacheCreationInputTokens Int      @default(0)
  totalTokens              Int      @default(0)
  costUsd                  Float    @default(0)
  status                   String   @default("completed") // completed | partial | error
  source                   String   @default("sdk-result") // sdk-result | step-fallback
  modelUsageJson           String   @default("{}")
  metadataJson             String   @default("{}")
  startedAt                DateTime @default(now())
  finishedAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([sessionId, turnId])
  @@index([sessionId, startedAt])
  @@index([targetKind, targetId, startedAt])
  @@index([modelId, startedAt])
  @@index([status, startedAt])
}

// P5 Claude Agent SessionStore：SDK transcript 条目镜像（append 写多条 entry），供跨轮/跨进程 resume。
model ClaudeAgentSessionEntry {
  id           String   @id @default(cuid())
  projectKey   String // SDK 从 cwd 派生；透明存储键
  sdkSessionId String
  subpath      String   @default("") // 主 transcript=""，子 agent 非空
  uuid         String? // 幂等键；SQLite unique 对 NULL 不去重 → 无 uuid 条目可多条
  entryJson    String // 一行 JSONL（SessionStoreEntry 原样）
  // P1（session PDC §6.2/§7.4）：稳定排序与排障字段。
  // appendSeq：同 (projectKey,sdkSessionId,subpath) 下单调递增，load 据此保序（createdAt 在 SQLite
  //   精度不足且 upsert 更新时会乱序）；uuid 重放时仅 create 分支分配，update 不触碰 → 重放不破坏顺序。
  // entryType / entryTimestamp：从 entry.type / entry.timestamp 冗余，方便排障与按类型清理。
  appendSeq      Int?
  entryType      String?
  entryTimestamp DateTime?
  createdAt      DateTime @default(now())
  // updatedAt 可空：SQLite 的 ALTER TABLE ADD COLUMN 不允许非常量默认值（CURRENT_TIMESTAMP），
  // 故迁移用「add nullable + UPDATE 回填」；@default(now())+@updatedAt 保证新写行恒有值，历史行回填后亦有值。
  updatedAt      DateTime? @default(now()) @updatedAt

  @@unique([projectKey, sdkSessionId, subpath, uuid])
  @@index([projectKey, sdkSessionId, subpath])
  @@index([projectKey, sdkSessionId, subpath, appendSeq])
  @@index([entryType])
}

model AgentChatMessage {
  id           String   @id
  sessionId    String
  role         String
  partsJson    String
  metadataJson String?
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session AgentChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, position])
  @@index([sessionId])
}

model AgentArticleProposal {
  id              String    @id @default(cuid())
  articleId       String
  sessionId       String?
  baseVersionHash String
  baseTitle       String    @default("")
  baseMarkdown    String    @default("")
  baseDigest      String    @default("")
  title           String?
  markdown        String
  digest          String?
  summary         String    @default("")
  status          String    @default("pending") // pending | applying | applied | rejected | superseded
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  appliedAt       DateTime?
  decidedAt       DateTime?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([sessionId])
  @@index([status])
}

model TechnicalDocument {
  id           String   @id @default(cuid())
  title        String   @default("")
  documentType String   @default("architecture") // architecture | implementation | call-chain | module-reference | dependency
  projectId    String
  contentPath  String?
  snapshotHash String   @default("")
  codeSourceJson String @default("{}")
  status       String   @default("draft")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chatSession AgentChatSession?
  versions    TechnicalDocumentVersion[]
  proposals   AgentTechnicalDocumentProposal[]

  @@index([projectId])
  @@index([updatedAt])
}

/// 统一存储对象：只描述文件实际存放位置和完整性。
/// SQLite 保留元数据；文件可位于本地 storage、阿里云 OSS 或未来的 S3/R2/COS/MinIO。
model StorageObject {
  id           String   @id @default(cuid())
  provider     String // local | aliyun-oss | s3 | r2 | cos | qiniu | minio
  bucket       String?
  key          String // provider 内部对象 key；local 时为 storage 根下相对路径
  localPath    String? // local provider 的相对路径，等同 key；保留字段便于迁移/审计
  url          String? // 可访问 URL；local provider 通常为 /api/storage/<id>
  contentType  String   @default("")
  size         Int      @default(0)
  sha256       String
  etag         String?
  visibility   String   @default("private") // private | public
  status       String   @default("synced") // local-only | remote-only | synced | failed
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assets Asset[]

  @@unique([provider, key])
  @@index([sha256])
  @@index([provider])
  @@index([createdAt])
}

/// 代码知识图谱缓存元数据。
/// 图谱文件本身落在 InkPress 本地数据目录，不进入文章素材统一存储层。
model CodeGraphCache {
  id           String   @id @default(cuid())
  provider     String   @default("graphify")
  status       String   @default("pending") // pending | building | ready | failed | stale
  spaceId      String?
  articleId    String?
  sourceKey    String
  projectName  String   @default("")
  root         String   @default("")
  snapshotHash String   @default("")
  gitHead      String?
  graphAssetId String?
  reportAssetId String?
  htmlAssetId  String?
  graphPath    String?
  reportPath   String?
  htmlPath     String?
  nodeCount    Int      @default(0)
  edgeCount    Int      @default(0)
  lastError    String?
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sourceKey])
  @@index([spaceId])
  @@index([articleId])
  @@index([snapshotHash])
  @@index([status])
}

model TechnicalDocumentVersion {
  id                  String   @id @default(cuid())
  technicalDocumentId String
  version             Int
  title               String
  markdown            String
  snapshotHash        String   @default("")
  sourceSnapshotJson  String   @default("{}")
  createdAt           DateTime @default(now())

  technicalDocument TechnicalDocument @relation(fields: [technicalDocumentId], references: [id], onDelete: Cascade)

  @@unique([technicalDocumentId, version])
  @@index([technicalDocumentId])
}

model AgentTechnicalDocumentProposal {
  id                  String    @id @default(cuid())
  technicalDocumentId String
  sessionId           String?
  baseVersionHash     String
  baseTitle           String    @default("")
  baseMarkdown        String    @default("")
  baseSnapshotHash    String    @default("")
  title               String?
  markdown            String
  snapshotHash        String?
  sourceSnapshotJson  String    @default("{}")
  summary             String    @default("")
  status              String    @default("pending")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  appliedAt           DateTime?
  decidedAt           DateTime?

  technicalDocument TechnicalDocument @relation(fields: [technicalDocumentId], references: [id], onDelete: Cascade)

  @@index([technicalDocumentId])
  @@index([sessionId])
  @@index([status])
}

model Space {
  id          String    @id @default(cuid())
  name        String // 空间名称
  description String    @default("") // 空间描述
  tagsJson    String    @default("[]") // 标签 JSON 数组
  sortOrder   Int       @default(0)
  isDefault   Boolean   @default(false) // 是否为默认空间（不可编辑/删除，至多一个）
  pinned      Boolean   @default(false) // 是否置顶（排序优先级：默认 > 置顶 > createdAt 倒序）
  // 软删除 / 回收站
  trashed     Boolean   @default(false)
  trashedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles Article[]
  assets   Asset[]
  tasks    Task[]

  @@index([trashed])
}

model Theme {
  id           String   @id @default(cuid())
  name         String // 显示名，如「优雅蓝」
  cssContent   String // markdown 主题 CSS（裸选择器）
  codeTheme    String   @default("atom-one-dark") // 代码高亮主题名
  primaryColor String?  @default("#3f51b5") // 用于解析 var()
  isBuiltIn    Boolean  @default(false)
  isDefault    Boolean  @default(false) // 是否为默认主题（DB 层至多一个为 true，由应用保证）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articles Article[]
}

model Material {
  // 图片缓存：外链 URL → wx_src 映射，避免重复上传
  id         String   @id @default(cuid())
  sourceUrl  String // 原始外链
  sourceHash String   @unique // sha1(sourceUrl)
  wxUrl      String? // uploadimg 返回的正文图 URL
  wxMediaId  String? // add_material 返回（封面用）
  kind       String // "body" | "cover"
  createdAt  DateTime @default(now())
}

/// 技能仓库（用户级 skill）
/// 通过界面新增/AI 生成的 skill 均落此表，同时镜像写入 resources/skills/<key>/SKILL.md
/// 使写作 agent 的 listSkills() 自动识别。resources/skills 下无 DB 记录的目录视为系统 skill（只读）。
model Skill {
  id           String   @id @default(cuid())
  skillKey     String   @unique // resources/skills 下的目录名（slugged）
  name         String // 显示名（取自 frontmatter）
  description  String   @default("")
  manual       String   @default("") // SKILL.md 正文（frontmatter 之后）
  promptHint   String? // AI 生成时记录的用途描述；手动新建为 null
  manifest     String? // 资源清单 JSON（压缩包上传时扫描得到，如 {"scripts":[...],"references":[...]}）
  hasResources Boolean  @default(false) // 是否含非 SKILL.md 的额外资源（references/scripts/agents 等）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

/// 系统级配置（key/value，value 为 JSON 字符串）
/// inkpress.llm = AI 模型配置数组，inkpress.oss = OSS 配置对象
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // JSON 字符串
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 文章素材库（统一存储的图片 / 视频 / 音频 / 文件）
/// 双重归属：可绑定到 Space（spaceId）和/或 Article（articleId）
model Asset {
  id          String    @id @default(cuid())
  name        String // 展示名（自动生成的短 UUID，如 a1b2c3d4.png）
  ossKey      String // 兼容旧字段：对象 key（OSS 或统一存储 key）
  url         String // 兼容旧字段：可访问 URL（云 URL 或 /api/storage/<id>）
  kind        String // "image" | "video" | "audio" | "file" | ...
  size        Int       @default(0) // 字节
  contentType String    @default("") // mime
  storageObjectId String?
  metadataJson String    @default("{}")
  // 元数据（供 AI 自动插图判断相关性）
  description String    @default("") // 素材描述
  tagsJson    String    @default("[]") // 标签（JSON 字符串数组）
  // 归属
  spaceId     String? // 所属空间（可空）
  articleId   String? // 所属文章（可空，编辑器内上传的素材）
  // 软删除 / 回收站
  trashed     Boolean   @default(false)
  trashedAt   DateTime?
  expiresAt   DateTime?
  // 微信公众号素材库同步（仅当上传时勾选了同步才写入；null=未尝试过同步）
  wxMediaId    String?  // add_material 返回的 media_id（永久素材）
  wxUrl        String?  // uploadimg 返回的 URL（正文图）或 add_material 的 url
  wxSyncStatus String?  // "success" | "failed" | null（null=未勾选同步）
  wxSyncError  String?  // 失败原因（同步失败时填，成功时清空）
  wxSyncedAt   DateTime? // 最后一次同步时间（成功/失败均更新）
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  storageObject StorageObject? @relation(fields: [storageObjectId], references: [id], onDelete: SetNull)
  space   Space?   @relation(fields: [spaceId], references: [id])
  article Article? @relation(fields: [articleId], references: [id])

  @@index([kind])
  @@index([createdAt])
  @@index([storageObjectId])
  @@index([spaceId])
  @@index([articleId])
  @@index([trashed])
  @@index([wxSyncStatus])
}

/// 素材块 — 灵感碎片（文字/图文/引用/链接）
/// 设计原则：字段平铺（非 JSON 嵌套），便于数据库索引和 AI 工具结构化读取
model Snippet {
  id          String    @id @default(cuid())

  // ─── 核心内容 ───
  title       String    @default("")  // 素材标题（可空，自动从 content 首行提取）
  content     String    // 正文（纯文本或轻量 Markdown，≤500字）
  kind        String    @default("text") // "text" | "image" | "quote" | "link"

  // ─── 图文混排 ───
  imageUrl    String?   // 主图 URL（内联图或粘贴图，直接可用于渲染和 AI 引用）
  imageAssetId String?  // 关联的 Asset ID（通过素材库上传时建立引用）
  imagesJson  String    @default("[]") // 多图场景：[{url, caption}] JSON数组

  // ─── 引用块 ───
  quoteSource String?   // 引用出处/作者

  // ─── 链接块 ───
  linkUrl     String?   // 原始 URL
  linkTitle   String?   // 链接标题（OG title 自动抓取 / 手动填写）
  linkDescription String? // 链接描述（OG description）
  linkImage   String?   // 链接预览图（OG image）

  // ─── 组织与检索 ───
  tagsJson    String    @default("[]") // 标签（已迁移至 SnippetTag 关系表；保留作回滚安全网，不再读写）
  color       String?   // 卡片强调色（预设色板，如 "amber" | "blue" | "green"）

  // ─── 来源追踪 ───
  sourceArticleId String? // 从哪篇文章摘录的（保持引用溯源）
  sourceUrl    String?    // 外部来源 URL（从网页摘录时记录）

  // ─── AI 辅助字段 ───
  embedding   String?   // 语义向量（JSON float[]），用于 AI 检索相关素材
  aiSummary   String?   // AI 生成的一句话摘要（用于 @面板快速预览）
  usageCount  Int       @default(0) // 被引用/使用次数（排序权重）

  // ─── 状态 ───
  pinned      Boolean   @default(false)
  trashed     Boolean   @default(false)
  trashedAt   DateTime?
  expiresAt   DateTime?   // 回收站过期时间（trashed 时置 now+30d；恢复/清理时清空）

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sourceArticle Article? @relation(fields: [sourceArticleId], references: [id], onDelete: SetNull)
  usages        SnippetUsage[]
  tagAssignments SnippetTagAssignment[]

  @@index([kind])
  @@index([pinned, createdAt])
  @@index([trashed])
  @@index([createdAt])
  @@index([usageCount])
  @@index([sourceArticleId])
}

/// 素材块被文章引用的记录（便于双向溯源：文章用了哪些素材 / 素材被哪些文章用了）
model SnippetUsage {
  id          String   @id @default(cuid())
  snippetId   String
  articleId   String
  insertedVia String   @default("at-mention") // "at-mention" | "drag-drop" | "sidebar"
  createdAt   DateTime @default(now())

  snippet     Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([snippetId])
  @@index([articleId])
  @@unique([snippetId, articleId])
}

/// 标签独立表（P4-21，原 Snippet.tagsJson 迁移而来）。name 全局唯一。
model SnippetTag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  assignments SnippetTagAssignment[]

  @@index([name])
}

/// snippet ↔ tag 多对多赋值（镜像 SnippetUsage 显式联表风格）。
model SnippetTagAssignment {
  id        String   @id @default(cuid())
  snippetId String
  tagId     String
  createdAt DateTime @default(now())

  snippet Snippet   @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  tag     SnippetTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([snippetId])
  @@index([tagId])
  @@unique([snippetId, tagId])
}

/// 任务管理：融合滴嗒清单 + Notion 的任务系统
/// 支持优先级、截止日期、子任务嵌套、多视图（列表/看板/日历）
model Task {
  id          String    @id @default(cuid())
  title       String
  content     String    @default("") // 富文本详情（Markdown）
  status      String    @default("todo") // todo | in_progress | done | archived
  priority    Int       @default(0) // 0=none, 1=low(🔵), 2=medium(🟡), 3=high(🟠), 4=urgent(🔴)
  dueDate     DateTime?
  completedAt DateTime?
  parentId    String? // 子任务关系
  spaceId     String? // 关联空间
  sortOrder   Int       @default(0) // 拖拽排序
  tagsJson    String    @default("[]") // 标签 JSON 数组
  isCollapsed Boolean   @default(false) // 子任务折叠状态
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   Task?  @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children Task[] @relation("TaskSubtasks")
  space    Space? @relation(fields: [spaceId], references: [id])

  @@index([parentId])
  @@index([spaceId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([sortOrder])
}

// P2.5 web_fetch 域名白名单：用户长期信任的域名，命中则 canUseTool 自动放行（不弹审批卡）。
// 全局用户级（不分 session/space）——是用户偏好，非会话级授权。
model WebFetchDomainAllowlist {
  id        String   @id @default(cuid())
  domain    String   @unique // 小写、去 www.，精确匹配
  note      String   @default("")
  riskJson  String   @default("{}") // URL 风险评估缓存（HTTPS/官方来源/权威域名等信号）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domain])
}
